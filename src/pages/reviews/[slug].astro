---
import Layout from '../../layouts/Layout.astro';
import { reviewers, type Reviewer } from '../../data/reviewers';

export function getStaticPaths() {
  return reviewers.map(reviewer => ({
    params: { slug: reviewer.slug },
    props: { reviewer }
  }));
}

interface Props {
  reviewer: Reviewer;
}

const { reviewer } = Astro.props;
const firstSentence = reviewer.background.split('.')[0] + '.';
---

<Layout 
  title={`${reviewer.name} — Code Review Services — NoMoreSlop`}
  description={firstSentence}
>
  <section class="max-w-5xl mx-auto px-6 py-16">
    <!-- Breadcrumb -->
    <nav class="mb-8" style="font-family: var(--font-mono); font-size: 0.875rem; color: var(--text-secondary);">
      <a href="/reviews" class="hover:text-accent transition-colors">Reviews</a>
      <span class="mx-2">→</span>
      <span style="color: var(--text-primary);">{reviewer.name}</span>
    </nav>

    <!-- Header -->
    <div class="mb-12">
      <h1 class="font-display text-5xl mb-6">{reviewer.name}</h1>
      <span class="inline-block px-4 py-2 text-sm" style="background: var(--bg-card); color: var(--accent); font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.1em; border: 1px solid var(--border-subtle);">{reviewer.specialty}</span>
    </div>

    <!-- Content -->
    <div class="space-y-12">
      <!-- Background -->
      <div>
        <h2 class="font-display text-3xl mb-6" style="color: var(--accent);">BACKGROUND</h2>
        <p class="text-lg leading-relaxed" style="color: var(--text-secondary);">{reviewer.background}</p>
      </div>

      <!-- What They Review -->
      <div>
        <h2 class="font-display text-3xl mb-6" style="color: var(--accent);">WHAT THEY REVIEW</h2>
        <div class="flex flex-wrap gap-3">
          {reviewer.whatHeChecks.map(item => (
            <span class="px-4 py-2 text-sm" style="background: var(--code-bg); color: var(--text-secondary); font-family: var(--font-mono); border: 1px solid var(--border-subtle);">{item}</span>
          ))}
        </div>
      </div>

      <!-- Pricing -->
      <div>
        <h2 class="font-display text-3xl mb-6" style="color: var(--accent);">PRICING</h2>
        <div class="grid md:grid-cols-2 gap-6">
          {reviewer.pricing.tiers.map(tier => (
            <div class="p-6" style="background: var(--bg-card); border: 1px solid var(--border-subtle);">
              <p class="text-sm mb-2" style="color: var(--text-secondary); font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.1em;">{tier.label}</p>
              <p class="font-display text-4xl mb-3" style="color: var(--accent);">{tier.price}</p>
              <p style="color: var(--text-secondary);">{tier.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Turnaround -->
      <div class="p-6" style="background: var(--bg-secondary); border: 1px solid var(--border-subtle);">
        <h3 class="font-display text-xl mb-3">TURNAROUND TIME</h3>
        <p class="text-lg" style="color: var(--text-secondary);">{reviewer.turnaround}</p>
      </div>

      <!-- CTA -->
      <div class="p-10 text-center" style="background: var(--bg-card); border: 2px solid var(--accent);">
        <h3 class="font-display text-3xl mb-6">READY TO GET YOUR CODE REVIEWED?</h3>
        <a 
          href={reviewer.ctaUrl}
          target="_blank" 
          rel="noopener noreferrer"
          class="btn btn-primary text-lg"
        >
          {reviewer.ctaLabel}
        </a>
      </div>

      <!-- Back Link -->
      <div class="pt-8" style="border-top: 1px solid var(--border-subtle);">
        <a href="/reviews" class="hover:text-accent transition-colors" style="font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.875rem;">
          ← Back to all reviewers
        </a>
      </div>
    </div>
  </section>
</Layout>
