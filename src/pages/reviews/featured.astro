---
import Layout from '../../layouts/Layout.astro';
import { reviewers } from '../../data/reviewers';

const featuredReviewers = reviewers.filter(r => r.featured);
---

<Layout 
  title="Featured Code Reviewers — NoMoreSlop"
  description="Featured code reviewers who specialize in reviewing AI-generated code and finding the logic-level issues automated tools miss."
>
  <section class="max-w-6xl mx-auto px-6 py-16">
    <!-- Header -->
    <div class="mb-16">
      <h1 class="mb-6">Featured Reviewers</h1>
      <p class="text-xl" style="color: var(--text-secondary); line-height: 1.7;">These reviewers are featured on the NoMoreSlop directory.</p>
    </div>

    <!-- Reviewers List -->
    <div class="space-y-10">
      {featuredReviewers.map((reviewer, index) => (
        <article class="card animate-fadein" style={`transition-delay: ${index * 0.05}s;`}>
          <div class="mb-8">
            <h2 class="font-display text-4xl mb-4">{reviewer.name}</h2>
            <span class="inline-block px-4 py-2 text-sm" style="background: var(--bg-secondary); color: var(--accent); font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.1em; border: 1px solid var(--border-subtle);">{reviewer.specialty}</span>
          </div>

          <div class="space-y-6 mb-8">
            <div>
              <h3 class="font-display text-2xl mb-4">BACKGROUND</h3>
              <p style="color: var(--text-secondary); line-height: 1.7;">{reviewer.background}</p>
            </div>

            <div>
              <h3 class="font-display text-2xl mb-4">PRICING SUMMARY</h3>
              <div class="flex flex-wrap gap-4">
                {reviewer.pricing.tiers.map(tier => (
                  <div class="px-4 py-3" style="background: var(--code-bg); border: 1px solid var(--border-subtle);">
                    <span class="font-display text-xl" style="color: var(--accent);">{tier.price}</span>
                    <span style="color: var(--text-secondary); font-size: 0.875rem; font-family: var(--font-mono);"> — {tier.label}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <a 
            href={`/reviews/${reviewer.slug}`}
            class="btn inline-block"
          >
            VIEW FULL PROFILE
          </a>
        </article>
      ))}
    </div>

    <!-- Back Link -->
    <div class="mt-16 pt-8" style="border-top: 1px solid var(--border-subtle);">
      <a href="/reviews" class="hover:text-accent transition-colors" style="font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.875rem;">
        ← Back to all reviewers
      </a>
    </div>
  </section>
</Layout>
